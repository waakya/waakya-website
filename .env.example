# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server-only. Used by the SLA/escalation job and by `npm run dev:login`,
# which prints a sign-in link so you can get in without an inbox.
# Never expose to the client, and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email notifications (Resend) ---
RESEND_API_KEY=
RESEND_FROM="Waakya <onboarding@resend.dev>"

# --- Proof storage (Cloudflare R2) ---
# Without these the app falls back to a private Supabase Storage bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=waakya-proofs

# --- The SLA job ---
# The scheduler presents this as `Authorization: Bearer <secret>` to
# /api/cron/sla. Without it, only a signed-in owner can run a tick, for their
# own business. Generate with: openssl rand -hex 32
CRON_SECRET=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Development only. Enables /api/test-login so Playwright can sign in without a
# real OTP email. Refused when NODE_ENV=production. Never set this in Vercel.
ALLOW_TEST_LOGIN=true

# Development only. Skips the login screen: the proxy signs you in as a seeded
# user (owner@waakya.test, or staff via the dev role switcher) so every screen
# is reachable without an inbox. Refused when NODE_ENV=production.
# Never set this in Vercel.
DEV_DISABLE_AUTH=false

# Testing only. Shows a "Continue as guest" button on the login screen that
# signs you in as guest@waakya.test without an OTP, so every feature can be
# tried. The first time on a project it needs SUPABASE_SERVICE_ROLE_KEY to
# create the guest user. Never set this in production.
ALLOW_GUEST_LOGIN=true
